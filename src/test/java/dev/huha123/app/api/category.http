### login
# @name login
POST http://localhost:8080/api/login
Content-Type: application/json

{
    "username": "admin",
    "password": "1234"
}

@auth_token = {{login.response.body.$.token}}

### Get all categories
GET http://localhost:8080/api/categories
Authorization: Bearer {{auth_token}}

### Get category by id
GET http://localhost:8080/api/categories/NOTICE
Authorization: Bearer {{auth_token}}

### Create category
POST http://localhost:8080/api/categories
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
    "id": "QNA",
    "name": "질의응답",
    "isUse": true
}

### Update category
PUT http://localhost:8080/api/categories/QNA
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
    "name": "Q&A",
    "isUse": false
}

### Delete category
DELETE http://localhost:8080/api/categories/QNA
Authorization: Bearer {{auth_token}}
